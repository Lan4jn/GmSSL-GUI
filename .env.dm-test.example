# 达梦数据库 (DM8) 联调与实库测试环境配置模板
# 使用说明：
# 1. 复制本文件到私有配置文件：cp .env.dm-test.example .env.dm-test
# 2. 设置权限保护私有凭据：chmod 600 .env.dm-test
# 3. 填写真实可用的达梦测试实例连接参数
# 
# ⚠️ 安全警告与隔离红线：
# - 严禁配置生产环境数据库连接！
# - 严禁使用 SYSDBA、SYSSSO 等系统管理员账号或系统模式！
# - 必须使用专用的独立空库/测试模式（建议单独创建用户与模式 GMSSL_TEST 或 GMSSL_TEST_*）！
# - 测试账号只需具备在对应专用 schema 下建表(CREATE TABLE)、建索引(CREATE INDEX)及常规 DML(SELECT/INSERT/UPDATE/DELETE) 权限。

# 达梦数据库 JDBC 连接 URL
# 格式参考：jdbc:dm://<HOST>:<PORT>?schema=<SCHEMA>
# 注意：PORT 默认为 5236；可在 URL 参数中显式指定 schema
DM_TEST_JDBC_URL=jdbc:dm://127.0.0.1:5236?schema=GMSSL_TEST

# 达梦数据库测试用户名（建议同模式名，如 GMSSL_TEST）
DM_TEST_USERNAME=GMSSL_TEST

# 达梦数据库测试用户密码（仅填入私有 .env.dm-test，禁止提交到仓库）
DM_TEST_PASSWORD=

# 达梦数据库测试模式名（Schema，建议使用独立空的 GMSSL_TEST）
DM_TEST_SCHEMA=GMSSL_TEST