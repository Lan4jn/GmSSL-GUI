# GmSSL GUI Linux amd64 Deployment Environment Template (Dameng DM8 Edition)
# Run ./init.sh (or ./scripts/init.sh) to automatically generate random engine & vault keys.
# Then configure your external Dameng DM8 database connection below.

# Web Port & Binding
GMSSL_BIND_ADDRESS=127.0.0.1
GMSSL_WEB_PORT=8088

# Session Cookie Security (true for HTTPS or production, false if direct HTTP without TLS reverse proxy)
GMSSL_SESSION_COOKIE_SECURE=true

# Engine Internal Communication Token (32-byte hex string)
GMSSL_ENGINE_TOKEN=YOUR_HEX_32_BYTES_ENGINE_TOKEN

# Vault Master Encryption Key (Base64-encoded 32-byte key)
GMSSL_VAULT_MASTER_KEY=YOUR_BASE64_32_BYTES_MASTER_KEY

# Initial Administrator Credentials (used only during initial bootstrapping)
GMSSL_BOOTSTRAP_USERNAME=admin
GMSSL_BOOTSTRAP_PASSWORD=YOUR_STRONG_PASSWORD

# Active Spring Profile (must be 'dm' for Dameng database)
SPRING_PROFILES_ACTIVE=dm

# External Dameng (DM8) Database Configuration
# Format: jdbc:dm://<HOST>:<PORT>?schema=<SCHEMA> (default port 5236)
# Note: Ensure the target user has CREATE TABLE and DML privileges in the schema.
# Execute artifacts/01_schema_dm8.sql in the DM8 schema prior to first start.
SPRING_DATASOURCE_URL=jdbc:dm://YOUR_DM8_HOST:5236?schema=YOUR_SCHEMA
SPRING_DATASOURCE_USERNAME=YOUR_DM8_USERNAME
# NOTE: If your database password contains special characters like ', wrap it in single quotes (e.g. 'My$Secret') or escape as '$' to prevent Docker Compose variable interpolation.
SPRING_DATASOURCE_PASSWORD='YOUR_DM8_PASSWORD'